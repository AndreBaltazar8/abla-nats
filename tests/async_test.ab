// natsAsyncClient against a real server (tools/test-async.sh): publishes
// buffered before the connection opens, subscriptions made before it opens,
// a queue-less fan-out, delivery limits and request/reply, and a server whose
// name never resolves leaving step(0) nonblocking.

import "abla/text"
import "abla/sys/linux/process"
import "../src/async.ab"

fun natsTestOptions(): NatsAsyncOptions {
    val port = linuxEnvironment("NATS_PORT")
    NatsAsyncOptions(["nats://127.0.0.1:${if (port.found) port.value else "4222"}"], "async-test", linuxEnvironment("NATS_TOKEN").value)
}

fun main: int {
    var subscriber = natsAsyncClient(natsTestOptions())
    var publisher = natsAsyncClient(natsTestOptions())
    val eventsSid = subscriber.subscribe("events.>")
    val limitedSid = subscriber.subscribe("limited")
    subscriber.unsubscribe(limitedSid, 2)
    val echoSid = subscriber.subscribe("service.echo")
    // the subscriber must be open before the publisher's buffer flushes
    var rounds = 0
    while (!subscriber.isConnected() && rounds < 200) {
        subscriber.step(10)
        rounds = rounds + 1
    }
    if (!subscriber.isConnected()) return 10
    if (!publisher.publish("events.a", "one") || !publisher.publish("events.b.c", "two")) return 20
    publisher.publish("limited", "1")
    publisher.publish("limited", "2")
    publisher.publish("limited", "3")
    val inbox = publisher.subscribe("_INBOX.async")
    publisher.publish("service.echo", "ping", "_INBOX.async")

    var events: array<string> = []
    var limited = 0
    var reply = ""
    rounds = 0
    while ((events.size < 2 || reply == "") && rounds < 300) {
        subscriber.step(5)
        publisher.step(5)
        for (message in subscriber.takeMessages()) {
            if (message.sid == eventsSid) events.append("${message.subject}=${message.payload}")
            else if (message.sid == limitedSid) limited = limited + 1
            else if (message.sid == echoSid) subscriber.publish(message.reply, "pong:${message.payload}")
        }
        for (message in publisher.takeMessages()) if (message.sid == inbox) reply = message.payload
        rounds = rounds + 1
    }
    // let the third "limited" arrive if the limit were broken
    rounds = 0
    while (rounds < 20) {
        subscriber.step(5)
        for (message in subscriber.takeMessages()) if (message.sid == limitedSid) limited = limited + 1
        rounds = rounds + 1
    }
    var connected = 0
    for (event in subscriber.takeEvents()) if (event.kind == "connected") connected = connected + 1
    subscriber.close()
    publisher.close()

    if (events.size != 2 || events[0] != "events.a=one" || events[1] != "events.b.c=two") return 30
    if (limited != 2) return 40
    if (reply != "pong:ping") return 50
    if (connected != 1) return 60

    // a nameserver that never answers: step(0) stays nonblocking, then the
    // lookup times out
    var lost = natsAsyncClient(NatsAsyncOptions(["nats://nats.example.invalid:4222"], "lost", connectTimeoutMilliseconds = 1500,
        maximumReconnectAttempts = 0, dnsNameserver = "10.255.255.1"))
    lost.publish("x", "y")
    val before = linuxMonotonicMilliseconds()
    var spins = 0
    while (spins < 100) {
        lost.step(0)
        spins = spins + 1
    }
    if (linuxMonotonicMilliseconds() - before > 200) return 70
    var resolveError = ""
    val lostDeadline = linuxMonotonicMilliseconds() + 5000
    while (resolveError == "" && linuxMonotonicMilliseconds() < lostDeadline) {
        lost.step(50)
        for (event in lost.takeEvents()) if (event.detail.contains("could not resolve")) resolveError = event.detail
    }
    lost.close()
    if (!resolveError.contains("dns timeout")) 71 else 0
}
