import "../src/nats.ab"

fun main: int {
    val stream = NatsStream(TcpConnection(-1), "INFO {\"server_id\":\"test\"}\r\nPING\r\nMSG events 7 reply.inbox 5\r\nhello\r\nHMSG headers 8 12 16\r\nNATS/1.0\r\n\r\ndata\r\n")
    val information = stream.next(1)
    val ping = stream.next(1)
    val message = stream.next(1)
    val headers = stream.next(1)
    val connectPayload = natsClient(NatsConfig(
        "127.0.0.1", 4222, "test", "", "", "", 3000, 5000
    )).connectPayload()
    if (information.kind != "info") 1
    else if (ping.kind != "ping") 2
    else if (message.kind != "message" || message.subject != "events") 3
    else if (message.sid != 7 || message.reply != "reply.inbox") 4
    else if (message.payload != "hello") 5
    else if (headers.kind != "message" || headers.subject != "headers") 6
    else if (headers.headers != "NATS/1.0\r\n\r\n" || headers.payload != "data") 7
    else if (!natsSubjectValid("events.created", false)) 8
    else if (natsSubjectValid("events.*", false)) 9
    else if (!natsSubjectValid("events.*", true)) 10
    else if (natsSubjectValid("events.>more", true)) 11
    else if (natsSubjectValid("events..created", true)) 12
    else if (connectPayload == "null" || connectPayload == "") 13
    else 0
}
